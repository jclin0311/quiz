# SQLite by default; use Postgres via docker compose:
DATABASE_URL=postgresql+psycopg://quiz:quiz@localhost:5432/quiz
# Google Identity Services web client id. When unset, a demo login is offered instead.
GOOGLE_CLIENT_ID=
# ALLOW_DEV_LOGIN=false
# Set true behind HTTPS.
COOKIE_SECURE=false
# Claude API key for the dashboard analysis. Without it, a deterministic summary is shown.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
